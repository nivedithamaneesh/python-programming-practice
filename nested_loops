for i in range(5):
    for j in range(i+1):
        print("*", end=" ")
    print()

for i in range(5,0,-1):
    for j in range(i):
        print("*", end=" ")
    print()

for i in range(5):
    for j in range(5-i-1):
        print(" ", end=" ")
    for j in range(2*i+1):
        print("*",end=" ")
    print()

rows=5
for i in range(1,rows+1):
    for j in range (rows-i):
        print(" ",end=" ")
    for j in range (i):
        print("*",end=" ")
    print()

for i in range(4,0,-1):
    for j in range(4-i):
        print(" ",end=" ")
    for j in range(2*i-1):
        print("*",end=" ")
    print()

for i in range(5):
    for j in range(i+1):
        print(j+1,end=" ")
    print()
